# App-menu launcher: (re)starts the PC side of the toy (chicco-piano.service).
# Install: ln -s "$PWD/tools/chicco-piano.desktop" ~/.local/share/applications/
[Desktop Entry]
Type=Application
Name=Chicco Piano
Comment=Restart the synth and WiFi bridge for the toy piano
Exec=sh -c 'systemctl --user restart chicco-piano && notify-send -i audio-x-generic "Chicco Piano" "Synth and bridge restarted"'
Icon=audio-x-generic
Terminal=false
Categories=Audio;AudioVideo;
